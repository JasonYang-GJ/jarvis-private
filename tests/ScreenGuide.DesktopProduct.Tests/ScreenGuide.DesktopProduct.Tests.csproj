<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenGuide.DesktopProtocol\ScreenGuide.DesktopProtocol.csproj" />
    <ProjectReference Include="..\..\src\ScreenGuide.DesktopClient\ScreenGuide.DesktopClient.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ScreenGuide.DesktopHost\ScreenGuide.DesktopHost.csproj" />
    <ProjectReference Include="..\ScreenGuide.DesktopClient.VoiceHarness\ScreenGuide.DesktopClient.VoiceHarness.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ScreenGuide.FakeCodexCli\ScreenGuide.FakeCodexCli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\prompts\runtime\**\*"
             Link="prompts\runtime\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
