<Window x:Class="ScreenGuide.DesktopClient.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始使用元枢" Width="760" Height="590" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="92" /><RowDefinition Height="*" /><RowDefinition Height="70" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SidebarBrush}" Padding="28,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="设置你的电脑工作助手" Foreground="White" FontFamily="Segoe UI Variable Display"
                               FontSize="23" FontWeight="SemiBold" />
                    <TextBlock x:Name="StepIndicatorText" Text="第 1 步，共 3 步" Foreground="#9DB0B8" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StepDot1" Width="10" Height="10" Fill="#5E91EA" Margin="4" />
                    <Ellipse x:Name="StepDot2" Width="10" Height="10" Fill="#4A5960" Margin="4" />
                    <Ellipse x:Name="StepDot3" Width="10" Height="10" Fill="#4A5960" Margin="4" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="34,28">
            <StackPanel x:Name="CodexStepPanel">
                <TextBlock Text="先认识元枢" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="元枢是电脑上的 AI 入口：打开后自动聆听，你直接说出目标，它就能执行已经开放的低风险电脑操作。"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20" />
                <Border Style="{StaticResource SurfaceBorder}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="CodexCheckIcon" Width="42" Height="42" CornerRadius="21" Background="#EDF2FA" HorizontalAlignment="Left">
                            <TextBlock x:Name="CodexCheckIconText" Text="…" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="CodexCheckTitleText" Text="正在检查本机中枢…" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="CodexCheckDetailText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="CodexHelpPanel" Visibility="Collapsed" Background="#FFF7E6" BorderBrush="#E4C47C"
                        BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,14,0,0">
                    <TextBlock Text="编程助手是可选能力。即使没有 Codex，你仍然可以使用语音、打开应用/网页/文件等普通电脑功能。"
                               TextWrapping="Wrap" />
                </Border>
                <Border Background="#EAF4F2" BorderBrush="#B7D8D0" BorderThickness="1" CornerRadius="4"
                        Padding="14" Margin="0,14,0,0">
                    <TextBlock Text="安全边界：监听状态始终可见，音频不保存；不会扫描硬盘、移动鼠标。发送、删除、支付、账号设置和密码输入不在当前开放范围。"
                               TextWrapping="Wrap" />
                </Border>
                <Button Content="重新检查" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                        Click="RecheckCodexButton_Click" />
            </StackPanel>

            <StackPanel x:Name="ProjectStepPanel" Visibility="Collapsed">
                <TextBlock Text="自动语音已经准备好" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="进入元枢后，麦克风会自动开始本机离线识别。你不需要点击按钮，也不需要输入文字。退出元枢后监听立即停止。"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20" />
                <Border Style="{StaticResource SurfaceBorder}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#D8ECE7" HorizontalAlignment="Left">
                            <Ellipse Width="14" Height="14" Fill="#1F8A6A" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="直接说话即可" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="例如：打开谷歌浏览器；用谷歌浏览器打开抖音；在当前窗口搜索天气。"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="ProjectStepMessageText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel x:Name="FirstTaskStepPanel" Visibility="Collapsed">
                <TextBlock Text="可以开始了" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="进入首页后，元枢会显示“正在聆听”。这时直接说出指令，明确的低风险操作会立即执行。"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                <Border Background="#EAF4F2" BorderBrush="#B7D8D0" BorderThickness="1" CornerRadius="5" Padding="18">
                    <StackPanel>
                        <TextBlock Text="当前可以直接执行" FontWeight="SemiBold" />
                        <TextBlock Text="打开已知应用、打开已知网站、在可靠识别的当前窗口搜索。"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="查看屏幕、访问文件、运行编程任务等敏感能力仍会要求单独授权。"
                                   Foreground="#A56210" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Button x:Name="BackButton" Content="上一步" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="BackButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                            Click="NextButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
