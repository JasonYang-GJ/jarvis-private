<Window x:Class="ScreenGuide.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕陪练状态"
        Width="430"
        Height="126"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Loaded="Window_Loaded">
    <Border x:Name="OverlayCard"
            Margin="10"
            Padding="18,15"
            CornerRadius="18"
            Background="#F5FFFFFF"
            BorderBrush="#D7E0ED"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#330F172A" BlurRadius="20" ShadowDepth="5" Opacity="0.32" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="48" Height="48" CornerRadius="16" Background="#EAF0FF">
                <Grid>
                    <Ellipse x:Name="StatusPulse" Width="12" Height="12" Fill="#2B66D9" />
                    <TextBlock x:Name="StatusSymbol" Text="●" FontSize="20" Foreground="#2B66D9"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="OverlayTitle" Text="后台陪练已就绪"
                           FontFamily="Microsoft YaHei UI" FontSize="16" FontWeight="Bold"
                           Foreground="#172033" />
                <TextBlock x:Name="OverlayDetail" Text="按 Ctrl + Shift + 空格开始说话"
                           Margin="0,5,0,0" FontFamily="Microsoft YaHei UI" FontSize="12"
                           Foreground="#657087" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
