<Window x:Class="ScreenGuide.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenGuide.App.Controls"
        Title="贾维斯粒子助手"
        Width="430"
        Height="455"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="HoverActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="Background" Value="#C9091721" />
            <Setter Property="BorderBrush" Value="#7148E7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EE102C3D" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D048E7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="AvatarRoot" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu FontFamily="Microsoft YaHei UI" FontSize="13">
                <MenuItem x:Name="SizeMenuItem" Header="缩小贾维斯" Click="SizeMenuItem_Click" />
                <MenuItem Header="打开设置" Click="SettingsMenuItem_Click" />
                <MenuItem Header="隐藏到任务栏" Click="HideMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="StartVoiceMenuItem" Header="启动语音陪伴" Click="StartVoiceMenuItem_Click" />
                <MenuItem x:Name="StopVoiceMenuItem" Header="停止麦克风" IsEnabled="False" Click="StopVoiceMenuItem_Click" />
                <Separator />
                <MenuItem Header="退出贾维斯" Click="ExitMenuItem_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid x:Name="LargeAvatarView">
            <controls:ParticleHelmetControl x:Name="LargeParticleHelmet"
                                            ParticleCount="2600"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />

            <Border x:Name="StatusPill"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="22,0,22,22"
                    Padding="14,8"
                    Background="#B8051018"
                    BorderBrush="#6048E7FF"
                    BorderThickness="1"
                    CornerRadius="18"
                    Opacity="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="StateAccentBorder" Width="7" Height="7" CornerRadius="4"
                                Background="#48E7FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="OverlayTitle"
                                   Text="贾维斯已就绪"
                                   Foreground="#EAFBFF"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="OverlayDetail"
                               Text="直接说“缩小”“设置”或“隐藏贾维斯”"
                               Width="330"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#91B7C9"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="10.5" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="HoverControls"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,14,0"
                        Opacity="0">
                <Button Content="设置" ToolTip="打开设置" Click="SettingsButton_Click"
                        Style="{StaticResource HoverActionButton}"
                        Height="28" Padding="10,0" Margin="0,0,6,0" />
                <Button Content="－" ToolTip="缩小成粒子核心" Click="CompactButton_Click"
                        Style="{StaticResource HoverActionButton}"
                        Width="28" Height="28" Margin="0,0,6,0" FontSize="16" />
                <Button Content="×" ToolTip="隐藏到任务栏，语音继续运行" Click="HideButton_Click"
                        Style="{StaticResource HoverActionButton}"
                        Width="28" Height="28" FontSize="16"
                        Foreground="#FFD6DC" BorderBrush="#78E93045" />
            </StackPanel>
        </Grid>

        <Grid x:Name="CompactAvatarView"
              Visibility="Collapsed"
              Width="112"
              Height="112"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ToolTip="说“展开贾维斯”恢复；右键菜单是备用操作">
            <controls:ParticleHelmetControl x:Name="CompactParticleHelmet"
                                            ParticleCount="780"
                                            Compact="True"
                                            Width="112"
                                            Height="112" />
            <Border x:Name="CompactStateAccent"
                    Width="9" Height="9" CornerRadius="5"
                    Background="#48E7FF"
                    BorderBrush="#E5030A0F" BorderThickness="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,8,8" />
        </Grid>
    </Grid>
</Window>
