<Window x:Class="ScreenGuide.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕陪练老师"
        Width="1040"
        Height="780"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource GuideBrush}">
                    <TextBlock Text="引" Foreground="White" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="屏幕陪练老师" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="留在原软件里，直接说，我用语音回答"
                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#E8F7F1" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SafeBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="唤醒与识别留在本机；仅授权画面和文字发往百炼"
                               Foreground="{StaticResource SafeBrush}" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="后台陪练状态" FontSize="14" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Rectangle Width="3" Fill="{StaticResource LineBrush}" RadiusX="2" RadiusY="2" />
                            <Ellipse x:Name="StatusLight" Width="18" Height="18" Fill="#A9B2C2"
                                     Stroke="White" StrokeThickness="4" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock x:Name="StatusTitle" Text="尚未开始" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="StatusDescription"
                                       Text="先检查语音组件，然后启动后台陪练。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="22"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <Button x:Name="StartBackgroundButton" Style="{StaticResource PrimaryButton}"
                                Content="开始后台陪练并隐藏" Click="StartBackgroundButton_Click" />
                        <Button x:Name="StopBackgroundButton" Style="{StaticResource QuietButton}"
                                Content="停止后台陪练" IsEnabled="False" Margin="0,10,0,0"
                                Click="StopBackgroundButton_Click" />
                        <TextBlock x:Name="LastVoiceStatusText" Text="尚未使用麦克风。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="无需切换窗口的语音流程"
                                   Foreground="{StaticResource MutedBrush}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="说“你好贾维斯”，然后直接提问"
                                   FontSize="28" FontWeight="Bold" Margin="0,7,0,0" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource GuideSoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="1" Foreground="{StaticResource GuideBrush}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="留在原软件" FontWeight="Bold" FontSize="15" Margin="0,10,0,0" />
                                <TextBlock Text="不打开陪练窗口" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource GuideSoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="2" Foreground="{StaticResource GuideBrush}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="用唤醒词叫我" FontWeight="Bold" FontSize="15" Margin="0,10,0,0" />
                                <TextBlock x:Name="VoiceShortcutText" Text="正在寻找可用快捷键…" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#E8F7F1"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="3" Foreground="{StaticResource SafeBrush}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="直接说出问题" FontWeight="Bold" FontSize="15" Margin="0,10,0,0" />
                                <TextBlock Text="回答后自动继续待命" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="1. 本机语音" FontSize="15" FontWeight="Bold" />
                                <TextBlock x:Name="RecognitionCapabilityText" Text="正在检查中文语音识别…"
                                           FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock x:Name="VoiceCapabilityText" Text="正在检查中文语音播报…"
                                           FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" />

                                <Separator Margin="0,15" />

                                <TextBlock Text="2. 连接阿里百炼" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="API Key 只保存到 Windows 凭据管理器；测试会发起一次不含画面的最小调用，可能按量计费。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="BailianApiKeyBox" Height="38" Padding="10,7"
                                                 ToolTip="粘贴华北2（北京）地域的百炼 API Key" />
                                    <Button x:Name="SaveBailianButton" Grid.Column="2" Content="保存并测试"
                                            Style="{StaticResource QuietButton}" Padding="18,8"
                                            Click="SaveBailianButton_Click" />
                                </Grid>
                                <TextBlock x:Name="BailianStatusText" Text="尚未配置百炼。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Margin="0,7,0,0" TextWrapping="Wrap" />

                                <Separator Margin="0,15" />

                                <TextBlock Text="3. 授权一个要观察的窗口" FontSize="15" FontWeight="Bold" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SelectWindowButton" Content="选择软件窗口"
                                            Style="{StaticResource QuietButton}" Padding="18,8"
                                            Click="SelectWindowButton_Click" />
                                    <TextBlock x:Name="SelectedWindowText" Grid.Column="2" Text="尚未选择"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <CheckBox x:Name="CloudConsentCheckBox" Margin="0,11,0,0"
                                          Checked="CloudConsentCheckBox_Changed"
                                          Unchecked="CloudConsentCheckBox_Changed">
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="我同意：每次提问后，只读取所选窗口的一帧画面，并把该画面和问题文字发送到阿里百炼。" />
                                </CheckBox>

                                <Border Background="#E8F7F1" CornerRadius="10" Padding="14,11" Margin="0,14,0,0">
                                    <TextBlock x:Name="PrivacyScopeText"
                                               Text="麦克风音频仍不上传；截图只在内存中处理，不保存到硬盘。"
                                               Foreground="{StaticResource SafeBrush}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#EAF0FF" CornerRadius="10" Padding="15,10">
            <TextBlock Text="隐私提示：音频不保存、不上传；只有勾选授权后，才会在每次提问时发送所选窗口的一帧画面和识别文字。"
                       Foreground="{StaticResource GuideBrush}" FontSize="13" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
