<Window x:Class="ScreenGuide.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贾维斯"
        Width="1040"
        Height="780"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource GuideBrush}" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="BrandImage" Stretch="UniformToFill" Visibility="Collapsed" />
                        <TextBlock x:Name="BrandFallback" Text="J" Foreground="White" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="贾维斯" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="留在原软件里，直接说，我用语音回答"
                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#E8F7F1" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SafeBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="后台常驻；自动跟随当前软件；仅屏幕问题按授权发送一帧"
                               Foreground="{StaticResource SafeBrush}" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="贾维斯运行状态" FontSize="14" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Rectangle Width="3" Fill="{StaticResource LineBrush}" RadiusX="2" RadiusY="2" />
                            <Ellipse x:Name="StatusLight" Width="18" Height="18" Fill="#A9B2C2"
                                     Stroke="White" StrokeThickness="4" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock x:Name="StatusTitle" Text="尚未开始" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="StatusDescription"
                                       Text="先检查语音组件，然后启动后台陪练。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="22"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <Button x:Name="StartBackgroundButton" Style="{StaticResource PrimaryButton}"
                                Content="启动贾维斯并隐藏设置" Click="StartBackgroundButton_Click" />
                        <Button x:Name="StopBackgroundButton" Style="{StaticResource QuietButton}"
                                Content="停止后台陪练" IsEnabled="False" Margin="0,10,0,0"
                                Click="StopBackgroundButton_Click" />
                        <TextBlock x:Name="LastVoiceStatusText" Text="尚未使用麦克风。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="设置与故障排查（平时无需打开）"
                                   Foreground="{StaticResource MutedBrush}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="叫我一次，之后可以连续对话"
                                   FontSize="28" FontWeight="Bold" Margin="0,7,0,0" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource GuideSoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="1" Foreground="{StaticResource GuideBrush}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="停留在任何软件" FontWeight="Bold" FontSize="15" Margin="0,10,0,0" />
                                <TextBlock Text="启动后自动后台待命" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource GuideSoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="2" Foreground="{StaticResource GuideBrush}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="用唤醒词叫我" FontWeight="Bold" FontSize="15" Margin="0,10,0,0" />
                                <TextBlock x:Name="VoiceShortcutText" Text="正在寻找可用快捷键…" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#E8F7F1"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="3" Foreground="{StaticResource SafeBrush}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="连续说下一句" FontWeight="Bold" FontSize="15" Margin="0,10,0,0" />
                                <TextBlock Text="说“你退下吧”结束" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="1. 本机语音" FontSize="15" FontWeight="Bold" />
                                <TextBlock x:Name="RecognitionCapabilityText" Text="正在检查中文语音识别…"
                                           FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock x:Name="VoiceCapabilityText" Text="正在检查中文语音播报…"
                                           FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" />

                                <Separator Margin="0,15" />

                                <TextBlock Text="2. 当前软件单帧授权" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="不再绑定固定软件。每次唤醒时，贾维斯会记住你当时正在使用的前台窗口；切换软件后，下次提问自动跟随。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Margin="0,7,0,0" TextWrapping="Wrap" />
                                <CheckBox x:Name="CloudConsentCheckBox" Margin="0,11,0,0"
                                          Checked="CloudConsentCheckBox_Changed"
                                          Unchecked="CloudConsentCheckBox_Changed">
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="我同意：仅当我主动询问当前界面、按钮或报错时，读取当时前台软件的一帧画面，并把画面和问题文字发送到阿里百炼。本授权只在本次运行有效。" />
                                </CheckBox>

                                <Border Background="#E8F7F1" CornerRadius="10" Padding="14,11" Margin="0,14,0,0">
                                    <TextBlock x:Name="PrivacyScopeText"
                                               Text="麦克风音频仍不上传；截图只在内存中处理，不保存到硬盘。"
                                               Foreground="{StaticResource SafeBrush}" FontSize="12" TextWrapping="Wrap" />
                                </Border>

                                <Separator Margin="0,15" />

                                <TextBlock Text="3. 连接阿里百炼模型" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="API Key 只保存到 Windows 凭据管理器；测试会发起一次不含画面的最小调用，可能按量计费。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                                <Border Background="#F3F7FF" BorderBrush="#D9E4FA" BorderThickness="1"
                                        CornerRadius="10" Padding="14,11" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="智能模型分工" FontWeight="Bold" FontSize="13" />
                                        <TextBlock x:Name="ModelRoutingText"
                                                   Text="普通问题：DeepSeek-V4-Flash（关闭思考）&#x0a;屏幕问题：Qwen3-VL-Flash（按需单帧）&#x0a;对话记忆：本次运行内，DeepSeek约90万Token；千问视觉约22万Token"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   Margin="0,5,0,0" LineHeight="19" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LastPerformanceText"
                                                   Text="尚无测速记录；完成一次提问后会显示听写、首字和开口时间。"
                                                   Foreground="{StaticResource GuideBrush}" FontSize="12"
                                                   Margin="0,7,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="BailianApiKeyBox" Height="38" Padding="10,7"
                                                 ToolTip="粘贴华北2（北京）地域的百炼 API Key" />
                                    <Button x:Name="SaveBailianButton" Grid.Column="2" Content="保存并测试"
                                            Style="{StaticResource QuietButton}" Padding="18,8"
                                            Click="SaveBailianButton_Click" />
                                </Grid>
                                <TextBlock x:Name="BailianStatusText" Text="尚未配置百炼。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Margin="0,7,0,0" TextWrapping="Wrap" />

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#EAF0FF" CornerRadius="10" Padding="15,10">
            <TextBlock Text="隐私提示：音频不保存、不上传；普通问题只发送文字；屏幕问题仅在本次运行授权后发送当前前台窗口的一帧。"
                       Foreground="{StaticResource GuideBrush}" FontSize="13" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
