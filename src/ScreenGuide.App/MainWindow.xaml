<Window x:Class="ScreenGuide.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕陪练老师"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource GuideBrush}">
                    <TextBlock Text="引" Foreground="White" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="屏幕陪练老师" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="一次只学一步，你来操作，我来核对" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#E8F7F1" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SafeBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="安全模式：只观察，不代替点击" Foreground="{StaticResource SafeBrush}" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="观察状态" FontSize="14" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Rectangle Width="3" Fill="{StaticResource LineBrush}" RadiusX="2" RadiusY="2" />
                            <Ellipse x:Name="StatusLight" Width="18" Height="18" Fill="#A9B2C2"
                                     Stroke="White" StrokeThickness="4" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock x:Name="StatusTitle" Text="尚未选择窗口" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="StatusDescription"
                                       Text="只有你主动选择后，软件才能读取那个窗口。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="14" LineHeight="23"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <Button x:Name="SelectWindowButton" Style="{StaticResource PrimaryButton}"
                                Content="选择要学习的软件" Click="SelectWindowButton_Click" />
                        <Button x:Name="StopButton" Style="{StaticResource QuietButton}"
                                Content="停止观察" IsEnabled="False" Margin="0,10,0,0" Click="StopButton_Click" />
                        <TextBlock Text="当前是界面原型，尚未读取任何屏幕内容。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="34">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="老师的下一步" Foreground="{StaticResource MutedBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="先选择一个窗口" FontSize="30" FontWeight="Bold" Margin="0,7,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource GuideSoftBrush}" CornerRadius="24" Width="48" Height="48">
                            <TextBlock Text="1" Foreground="{StaticResource GuideBrush}" FontSize="21" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="26">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="请选择你想学习的软件窗口，例如 GitHub Desktop。第一版会先让你亲自操作，不会接管鼠标。"
                                       FontSize="18" LineHeight="31" TextWrapping="Wrap" />
                            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="16,13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="为什么这样做？" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="  先把观察权限做对，再增加语音和智能判断。"
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="有问题时，你可以直接说" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock Text="“我现在在哪个界面？”" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="语音功能稍后接入" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#EAF0FF" CornerRadius="10" Padding="15,10">
            <TextBlock Text="隐私提示：真实截图、录音、API Key 和个人日志不会进入 GitHub 仓库。"
                       Foreground="{StaticResource GuideBrush}" FontSize="13" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
