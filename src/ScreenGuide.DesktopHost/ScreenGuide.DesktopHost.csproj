<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenGuide.Agent.Abstractions\ScreenGuide.Agent.Abstractions.csproj" />
    <ProjectReference Include="..\ScreenGuide.Agent.Codex\ScreenGuide.Agent.Codex.csproj" />
    <ProjectReference Include="..\ScreenGuide.AI.Core\ScreenGuide.AI.Core.csproj" />
    <ProjectReference Include="..\ScreenGuide.AI.DeepSeek\ScreenGuide.AI.DeepSeek.csproj" />
    <ProjectReference Include="..\ScreenGuide.AI.Qwen\ScreenGuide.AI.Qwen.csproj" />
    <ProjectReference Include="..\ScreenGuide.Core\ScreenGuide.Core.csproj" />
    <ProjectReference Include="..\ScreenGuide.DesktopProtocol\ScreenGuide.DesktopProtocol.csproj" />
    <ProjectReference Include="..\ScreenGuide.Evidence\ScreenGuide.Evidence.csproj" />
    <ProjectReference Include="..\ScreenGuide.Persistence\ScreenGuide.Persistence.csproj" />
    <ProjectReference Include="..\ScreenGuide.Skills.Abstractions\ScreenGuide.Skills.Abstractions.csproj" />
    <ProjectReference Include="..\ScreenGuide.Skills.Windows\ScreenGuide.Skills.Windows.csproj" />
    <ProjectReference Include="..\ScreenGuide.Vision.Abstractions\ScreenGuide.Vision.Abstractions.csproj" />
    <ProjectReference Include="..\ScreenGuide.Vision.Windows\ScreenGuide.Vision.Windows.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\prompts\runtime\**\*"
             Link="prompts\runtime\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
